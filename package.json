{
  "name": "strongerfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend", "packages/contracts", "packages/nutrition-engine", "packages/training-engine"],
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "npm run start --workspace @strongerfit/frontend",
    "android": "npm run android --workspace @strongerfit/frontend",
    "dev:frontend": "npm run start --workspace @strongerfit/frontend",
    "dev:backend": "npm run dev --workspace @strongerfit/backend",
    "dev:web": "npm run web --workspace @strongerfit/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "scan:bundle": "node scripts/scan-bundle.mjs frontend/dist",
    "supabase:start": "supabase start --workdir backend",
    "supabase:stop": "supabase stop --workdir backend",
    "supabase:serve": "supabase functions serve api --workdir backend",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:types": "supabase gen types typescript --local --workdir backend --schema public > packages/contracts/src/database.types.ts",
    "db:test": "supabase db reset --workdir backend && supabase db lint --workdir backend --level warning --fail-on error && supabase test db --workdir backend"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
